PORT=3000

# MSSQL (Docker محليًا أو سيرفر بعيد)
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=REDACTED
DB_NAME=menucraft

# JWT secrets — قيم عشوائية قوية (32+ حرف على الأقل)
# السيرفر يرفض البدء إذا كانت القيم افتراضية/ضعيفة/placeholder.
# أنشئ قيم جديدة بـ:
#   node -e "const c=require('crypto');console.log(c.randomBytes(36).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# دومين الفرونت المسموح له بالاتصال (CORS)
CORS_ORIGIN=https://your-app.vercel.app
