# Local development API connection.
# Leave VITE_API_URL_ABSOLUTE unset so API calls stay relative (/api/...)
# and go through the Vite dev proxy to http://127.0.0.1:3000 (see vite.config.ts).
# Same-origin keeps the HttpOnly SameSite=Lax session cookie working.

# VITE_API_URL_ABSOLUTE=https://api.vertex-electric.org
